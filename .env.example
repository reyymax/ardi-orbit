# --- LLM provider (any one is enough; litellm picks based on model name) ---
# Xiaomi MiMo via OpenAI-compatible endpoint
MIMO_API_KEY=sk-...
MIMO_API_BASE=https://platform.xiaomimimo.com/v1

# Fallbacks (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model selection ---
# Examples: "openai/mimo-v2.5-reasoner", "anthropic/claude-sonnet-4-5", "openai/gpt-4o"
ARDI_ORBIT_SOLVER_MODEL=openai/mimo-v2.5-reasoner
ARDI_ORBIT_STRATEGY_MODEL=openai/mimo-v2.5-flash

# --- ardi-agent binary (must be in PATH or set absolute) ---
ARDI_AGENT_BIN=ardi-agent
AWP_WALLET_BIN=awp-wallet

# --- Behavior ---
ARDI_ORBIT_MIN_CONFIDENCE=0.75
ARDI_ORBIT_MAX_COMMITS_PER_EPOCH=5
ARDI_ORBIT_DRY_RUN=true
ARDI_ORBIT_LOG_LEVEL=INFO
ARDI_ORBIT_STATE_DIR=~/.ardi-orbit
